# JML Projet Vendeur — modèle de configuration
# Copier vers .env sur le serveur puis renseigner les valeurs localement.
# Ne jamais committer .env ni afficher les secrets dans les logs.

# Serveur
PORT=3000
NODE_ENV=production
PUBLIC_APP_URL=https://jml.immo
CURRENT_DATA_YEAR=2025

# PostgreSQL — requis pour conserver les dossiers et les ventes entre redémarrages.
DATABASE_URL=
# Contabo/PostgreSQL local sans TLS : false. Base distante avec TLS : laisser true.
DATABASE_SSL=false

# Administration — définir un mot de passe fort avant d'exposer l'application.
JML_ADMIN_PASSWORD=

# Moteur DVF / agent d'analyse
# IMMO_DATA_API_KEY est nécessaire uniquement aux fonctions qui interrogent Immo Data.
IMMO_DATA_API_BASE_URL=https://api.immo-data.fr
IMMO_DATA_API_KEY=
ESTIMATOR_AGENT_SECRET=

# Géolocalisation et services Google (facultatifs, selon les modules activés)
GOOGLE_MAPS_API_KEY=
GOOGLE_STREETVIEW_API_KEY=
GOOGLE_PLACES_API_KEY=

# Explication IA du marché (facultatif ; les fonctions IA peuvent être indisponibles sans clé)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Données Banque de France / Webstat (facultatif)
WEBSTAT_API_KEY=

# Courriels transactionnels (facultatif ; nécessite une clé et un expéditeur autorisé)
RESEND_API_KEY=
RESEND_FROM=

# Connexion Google (facultatif ; ne pas renseigner si le module n'est pas utilisé)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
